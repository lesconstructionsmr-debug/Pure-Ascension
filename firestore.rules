rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Vérifie si l'utilisateur est authentifié avec le bon UID
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Règles pour les profils utilisateur
    match /users/{uid} {
      // Un utilisateur peut lire son propre profil
      allow read: if isOwner(uid);
      
      // Création de compte initiale
      allow create: if isOwner(uid) 
        && request.resource.data.stripe_subscription_status == 'inactive'
        && request.resource.data.planLevel == 'none'
        && request.resource.data.isPremium == false;
      
      // Mise à jour de compte par l'utilisateur
      allow update: if isOwner(uid)
        // Interdire formellement au client de modifier les champs liés à Stripe/Premium
        // (snake_case + camelCase — le webhook écrit les deux conventions)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'stripe_subscription_status',
          'stripe_subscription_id',
          'stripe_customer_id',
          'stripeSubscriptionStatus',
          'stripeSubscriptionId',
          'stripeCustomerId',
          'isPremium',
          'revenuecat_subscription_status',
          'revenuecat_product_id',
          'revenuecat_store',
          'revenuecat_environment',
          'revenuecat_updated_at'
        ])
        // planLevel : le client peut seulement choisir / rester en "free" (pas s'auto-promouvoir)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['planLevel'])
          || request.resource.data.planLevel == 'free'
        );
        
      // Seul un admin ou webhook (via SDK Admin) peut modifier les abonnements.
      // Firebase Security Rules ne s'appliquent pas aux accès admin Firebase (Netlify functions).

      // Règles pour les sous-collections de progression quotidienne
      match /progress/{date} {
        allow read, write: if isOwner(uid);
      }
      
      // Règles pour le programme d'entraînement/nutrition stocké sous l'utilisateur
      // Le programme lui-même peut être stocké dans le document utilisateur (users/{uid}.program)
    }

    // Règles pour les retours (feedbacks)
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if false; // Les utilisateurs ne peuvent pas lire les retours des autres
    }

    // Règles pour les parrainages (referrals)
    match /referrals/{referralId} {
      allow read: if request.auth != null 
        && (resource.data.referrerId == request.auth.uid 
            || resource.data.refereeId == request.auth.uid);
      allow create: if false; // Seul le backend admin peut créer
      allow update, delete: if false;
    }
  }
}
